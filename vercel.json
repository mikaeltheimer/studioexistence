{
  "redirects": [
    { "source": "/whale-song", "destination": "/echoes#/whale", "permanent": true },
    { "source": "/whale-song/", "destination": "/echoes#/whale", "permanent": true },
    { "source": "/droid-lang", "destination": "/echoes#/droide", "permanent": true },
    { "source": "/droid-lang/", "destination": "/echoes#/droide", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/bucket-list/partage",
      "destination": "/api/bucket-share"
    },
    {
      "source": "/bucket-list/partage/",
      "destination": "/api/bucket-share"
    }
  ],
  "functions": {
    "api/bucket-share.js": {
      "includeFiles": "bucket-list/index.html"
    },
    "api/bucket-og.js": {
      "includeFiles": "{bucket-list/index.html,bucket-list/fonts/**}"
    }
  }
}
