{
  "redirects": [
    {
      "source": "/whale-song",
      "destination": "/echoes#/whale",
      "permanent": true
    },
    {
      "source": "/whale-song/",
      "destination": "/echoes#/whale",
      "permanent": true
    },
    {
      "source": "/droid-lang",
      "destination": "/echoes#/droide",
      "permanent": true
    },
    {
      "source": "/droid-lang/",
      "destination": "/echoes#/droide",
      "permanent": true
    },
    {
      "source": "/terms",
      "destination": "/conditions/#en",
      "permanent": false
    },
    {
      "source": "/privacy",
      "destination": "/confidentialite/#en",
      "permanent": false
    },
    {
      "source": "/bucket-list/cadeau",
      "destination": "/bucket-list/?cadeau=",
      "permanent": false
    },
    {
      "source": "/bucket-list/cadeau/",
      "destination": "/bucket-list/?cadeau=",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/bucket-list/partage",
      "destination": "/api/bucket-share"
    },
    {
      "source": "/bucket-list/partage/",
      "destination": "/api/bucket-share"
    }
  ],
  "functions": {
    "api/bucket-share.js": {
      "includeFiles": "bucket-list/index.html"
    },
    "api/bucket-og.js": {
      "includeFiles": "{bucket-list/index.html,bucket-list/fonts/**}"
    },
    "api/gift.js": {
      "includeFiles": "{bucket-list/fonts/**,bucket-list/cadeau-*.jpg}"
    },
    "api/stripe-webhook.js": {
      "includeFiles": "{bucket-list/fonts/**,bucket-list/cadeau-*.jpg}"
    }
  },
  "crons": [
    {
      "path": "/api/blob-cleanup",
      "schedule": "17 8 1 * *"
    }
  ]
}
